# ============================================================================
# SOPIA environment configuration - EXAMPLE
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Database (PostgreSQL + pgvector) ---
# Docker Compose default:
DATABASE_URL=postgresql://sopia:sopiapass@localhost:5432/sopia
# Or a managed provider, e.g. Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
POSTGRES_USER=sopia
POSTGRES_PASSWORD=sopiapass
POSTGRES_DB=sopia

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider: "local" (Ollama) or "gemini" ---
AI_PROVIDER=local

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:1.5b (~1.0 GB) is the recommended default for a 16 GB laptop: light on
# RAM and still reliable at the strict JSON output quizzes/exams need. Step up to
# qwen2.5:3b (~1.9 GB) or llama3 (~4.7 GB) if you have RAM to spare. Run
# `ollama list` to see what you already have, then re-run scripts/check_model.py.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=mxbai-embed-large
# How long Ollama keeps the model in RAM after a request (e.g. 30s, 2m, 5m, -1 to
# never unload). Shorter = freer memory, slower first answer.
OLLAMA_KEEP_ALIVE=2m
# Threads Ollama may use for CPU inference. Leave at 0 to let Ollama use all
# physical cores; set to e.g. 2 to keep the machine responsive during answers.
OLLAMA_NUM_THREAD=0

# Gemini (optional). Leave API key blank unless using the gemini provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- Embeddings ---
# MUST match the active embedding model output:
#   mxbai-embed-large (Ollama) -> 1024
#   text-embedding-004 (Gemini) -> 768
EMBEDDING_DIM=1024

# --- Uploads / chunking / retrieval ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
# Minimum cosine similarity for a chunk to count as relevant context.
# Higher = stricter/more refusals, lower = more recall. Tune per corpus.
MIN_RELEVANCE=0.55


