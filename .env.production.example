# ============================================================================
# SOPIA API - PRODUCTION configuration template
#
# Copy to `.env` on the server (the same directory as this file), fill in real
# values, and start the API with `python backend/serve.py`.
#
# With ENVIRONMENT=production the API refuses to start if SECRET_KEY is weak,
# CORS_ORIGINS still points only at localhost, or ALLOWED_HOSTS is "*". Those
# checks exist so a missing value can never ship a forgeable signing key.
#
# NEVER commit the filled-in `.env`.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=production

# --- Database (Neon / managed PostgreSQL with pgvector) ----------------------
# Managed providers require TLS; keep `sslmode=require`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Security ----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Rotating this logs every user out.
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Must include the real frontend origin, or the browser will block API calls.
CORS_ORIGINS=https://sopia.example.com

# Public host(s) of this API, comma-separated. Rejects Host-header attacks.
# Include the bare host name only (no scheme, no port).
ALLOWED_HOSTS=sopia.example.com,api.sopia.example.com

# Hide the interactive API docs on a public server.
ENABLE_API_DOCS=false

# Per-client rate limiting. Keep enabled in production.
RATE_LIMIT_ENABLED=true

# --- AI provider: "local" (Ollama) or "gemini" -------------------------------
AI_PROVIDER=local

# --- Local LLM (Ollama) ------------------------------------------------------
# Ollama runs on this same host; see DEPLOYMENT.md.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=mxbai-embed-large
# How long the model stays in RAM after a request (`30s`, `2m`, `-1` = forever).
# A short value keeps a small server responsive at the cost of reload time.
OLLAMA_KEEP_ALIVE=2m
# Threads for CPU inference. 0 = all physical cores. Leave one core free on a
# small VM so the API and database remain responsive during generation.
OLLAMA_NUM_THREAD=0

# --- Gemini (only when AI_PROVIDER=gemini) -----------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- Embeddings --------------------------------------------------------------
# MUST match the embedding model output:
#   mxbai-embed-large (Ollama)        -> 1024
#   text-embedding-004 (Gemini)       -> 768
# Changing this changes the pgvector column, so existing documents must be
# re-ingested. Keep 1024 unless you are deliberately migrating providers.
EMBEDDING_DIM=1024

# --- Uploads -----------------------------------------------------------------
# Absolute path on the server (survives redeploys and is easy to back up).
UPLOAD_DIR=/var/lib/sopia/uploads
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# --- Chunking and retrieval --------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
# Higher = stricter (more refusals), lower = more recall. Tune per corpus.
MIN_RELEVANCE=0.55

# --- Anonymous access ----------------------------------------------------------
# Organisation whose SOPs anonymous visitors may search. Leave blank to require a
# sign-in for everything; set it to publish Chat and Interview practice to visitors.
PUBLIC_ORGANIZATION_ID=
