# ============================================================================
# SOPIA frontend - PRODUCTION build configuration
#
# Vite reads `.env.production` automatically during `npm run build`, so the API
# URL below is compiled into the bundle. It is NOT read at runtime - rebuilding
# is required to change it.
#
# Copy to `.env.production` before building:
#     cp .env.production.example .env.production
#     npm run build
#
# Without this file the bundle falls back to http://localhost:8000/api/v1 and a
# deployed site would call the visitor's own machine.
# ============================================================================

# Public base URL of the SOPIA API, including the /api/v1 prefix.
# Must match ALLOWED_HOSTS / CORS_ORIGINS in the backend `.env`.
VITE_API_URL=https://api.sopia.example.com/api/v1
