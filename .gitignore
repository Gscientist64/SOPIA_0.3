# --- Secrets: never commit these ---
.env
.env.*
!.env.example
# Deployment templates are intentionally tracked; they hold no real values.
!.env.production.example
*.pem
*.key
# Local run notes containing the admin password in clear text.
login.txt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / frontend ---
node_modules/
dist/
build/
.vite/
*.local

# --- Uploads / user data (may contain confidential SOPs) ---
backend/uploads/
backend/data/
# Source SOPs to ingest locally. Kept out of the public repository; the
# organisation's own procedures are not ours to publish.
sops/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# --- Tooling artefacts ---
.kilo/

# --- Offline demo build output (3+ GB, assembled locally) ---
dist-offline/
*.spec.bak
